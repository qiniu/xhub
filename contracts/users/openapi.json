  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "user_email": {
            "type": "string"
          },
          "user_alias": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "user_role": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "blocked": {
            "type": "boolean"
          },
          "max_budget": {
            "type": "number",
            "nullable": true,
            "format": "double"
          },
          "spend": {
            "type": "number",
            "format": "double"
          },
          "teams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserTeam"
            }
          },
          "organizations": {
            "type": "array",
            "items": {},
            "description": "当前空占位，不是组织权限。 / Currently empty placeholder, not organization permissions."
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "当前空占位，不是可用模型列表。 / Currently empty placeholder, not available models."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "key_count": {
            "type": "integer",
            "description": "当前固定0占位，不是实际密钥数。 / Currently zero placeholder, not actual key count."
          },
          "sso_user_id": {
            "type": "string",
            "nullable": true
          },
          "tpm_limit": {
            "type": "number",
            "nullable": true,
            "format": "double"
          },
          "rpm_limit": {
            "type": "number",
            "nullable": true,
            "format": "double"
          },
          "budget_reset_day": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          },
          "budget_reset_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "budget_duration": {
            "type": "string",
            "nullable": true
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          },
          "sso_connection_id": {
            "type": "string"
          },
          "sso_connection_name": {
            "type": "string"
          },
          "sso_external_id": {
            "type": "string"
          },
          "sso_binding_managed": {
            "type": "boolean"
          }
        },
        "required": [
          "user_id",
          "user_email",
          "user_alias",
          "user_name",
          "user_role",
          "role",
          "status",
          "blocked",
          "max_budget",
          "spend",
          "teams",
          "organizations",
          "models",
          "created_at",
          "updated_at",
          "key_count",
          "sso_user_id",
          "tpm_limit",
          "rpm_limit",
          "budget_reset_day",
          "budget_reset_at",
          "budget_duration",
          "metadata"
        ]
      },
      "UserTeam": {
        "type": "object",
        "properties": {
          "team_id": {
            "type": "string"
          },
          "team_alias": {
            "type": "string"
          },
          "user_role": {
            "type": "string"
          },
          "organization_id": {
            "type": "string"
          }
        },
        "required": [
          "team_id",
          "team_alias",
          "user_role",
          "organization_id"
        ]
      },
      "UserDetail": {
        "type": "object",
        "properties": {
          "user_info": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "user_info"
        ]
      },
      "LegacyBudget": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0,
            "nullable": true,
            "format": "double"
          },
          {
            "type": "string"
          }
        ],
        "description": "单人兼容有限非负数字字符串；空字符串/null清空，省略保留（创建时不限额），0禁止消费；字符串的语义由服务校验。 / Single-user compatibility: finite nonnegative numeric strings; empty string/null clears, omission preserves (uncapped on create), zero denies spend. String semantics are checked by the service.",
        "x-go-type": "json.RawMessage"
      },
      "LegacyRate": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0,
            "nullable": true,
            "format": "double"
          },
          {
            "type": "string"
